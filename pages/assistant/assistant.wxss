/* assistant.wxss */
page {
  background-color: #f6f6f6;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
  display: flex;
  justify-content: center;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.1);
}

/* 头部样式 */
.header {
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
  padding: 30rpx 40rpx;
  color: white;
  position: relative;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 连接状态指示器 */
.connection-status {
  position: absolute;
  top: 30rpx;
  right: 40rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 30rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.connected .status-dot {
  background-color: #4caf50;
  box-shadow: 0 0 8rpx #4caf50;
}

.disconnected .status-dot {
  background-color: #f44336;
  box-shadow: 0 0 8rpx #f44336;
}

.status-text {
  font-size: 22rpx;
  color: white;
}

/* 聊天区域 */
.chat-container {
  flex: 1;
  padding: 13rpx;
  overflow-y: auto;
}

/* 消息处理动画提示区域 */
.processing-indicator {
  text-align: center;
  padding: 40rpx 0;
  background-color: rgba(240, 248, 240, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 12rpx;
  margin: 20rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.processing-text {
  color: #2E7D32;
  font-size: 32rpx;
  font-weight: bold;
  opacity: 0;
  animation: textFade 5s ease-in-out infinite;
}

@keyframes textFade {
  0% { opacity: 0; transform: translateY(10rpx); }
  10% { opacity: 1; transform: translateY(0); }
  90% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-10rpx); }
}

/* 消息样式 */
.message-item {
  display: flex;
  margin-bottom: 30rpx;
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.message-item.user {
  flex-direction: row-reverse;
  padding-right: 10rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right:20rpx;
}

.user .avatar {
  background-color: #4CAF50;
  color: white;
  margin-right: 10rpx;
}

.assistant .avatar {
  background-color: #2196F3;
  color: white;
}

.avatar-icon {
  font-size: 40rpx;
}

.message-content {
  max-width: 70%;
  margin: 0 20rpx;
}

.user .message-content {
  margin-right: 20rpx;
}

.assistant .message-content {
  margin-left: 0;
}

.message-text {
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.message-text text {
  white-space: pre-wrap;
  word-break: break-word;
}

.user .message-text {
  background-color: #4CAF50;
  color: white;
  border-top-right-radius: 4rpx;
}

.assistant .message-text {
  background-color: white;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.message-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
  text-align: right;
}

.user .message-time {
  text-align: right;
}

.assistant .message-time {
  text-align: left;
}

/* 建议列表 */
.suggestion-list {
  margin-top: 16rpx;
}

/* 输入区域 */
.input-container {
  padding: 20rpx 30rpx;
  border-top: 2rpx solid #e0e0e0;
  background-color: white;
  position: relative;
}

.input-box {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 10rpx 20rpx;
}

.input-field {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

/* 输入模式切换按钮 */
.input-mode-toggle {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 10rpx;
}

.input-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.7;
}

/* 语音按钮 */
.voice-button {
  flex: 1;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f8f8f8;
  border-radius: 30rpx;
  border: 1rpx solid #e0e0e0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.voice-button.recording {
  background-color: #e8f5e9;
  color: #4CAF50;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 录音动效 */
.recording-animation {
  position: absolute;
  left: 24rpx;
  display: flex;
  align-items: center;
}

.recording-wave {
  width: 8rpx;
  height: 16rpx;
  background-color: #4CAF50;
  margin: 0 4rpx;
  border-radius: 4rpx;
  animation: wave 1.2s infinite ease-in-out;
}

.recording-wave:nth-child(1) {
  animation-delay: 0s;
}

.recording-wave:nth-child(2) {
  animation-delay: 0.3s;
  height: 24rpx;
}

.recording-wave:nth-child(3) {
  animation-delay: 0.6s;
  height: 32rpx;
}

@keyframes wave {
  0%, 100% {
    transform: scaleY(0.5);
  }
  50% {
    transform: scaleY(1);
  }
}

/* 取消录音提示 */
.cancel-recording-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 160rpx;
  display: flex;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 16rpx 0;
  font-size: 24rpx;
  border-radius: 8rpx;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.3s;
  pointer-events: none;
}

.cancel-recording-tip.visible {
  opacity: 1;
  transform: translateY(0);
}

.send-button {
  padding: 16rpx 30rpx;
  background-color: #e0e0e0;
  color: #999;
  border-radius: 30rpx;
  font-size: 28rpx;
  transition: all 0.3s;
}

.send-button.active {
  background-color: #4CAF50;
  color: white;
}

.send-button.disabled {
  background-color: #e0e0e0;
  color: #999;
  opacity: 0.6;
}

/* 停止按钮样式 */
.stop-button {
  padding: 16rpx 30rpx;
  background-color: #f44336;
  color: white;
  border-radius: 30rpx;
  font-size: 28rpx;
  transition: all 0.3s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.stop-button.active {
  background-color: #d32f2f;
}

.stop-button.disabled {
  opacity: 0.6;
}

/* 查询建议 */
.query-suggestions {
  margin-bottom: 20rpx;
}

.suggestion-scroll {
  white-space: nowrap;
  height: 80rpx;
}

.query-tag {
  display: inline-block;
  padding: 12rpx 24rpx;
  background-color: #e8f5e9;
  color: #4CAF50;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
  transition: all 0.3s;
}

.query-tag:active {
  background-color: #4CAF50;
  color: white;
}

/* 流式输出指示器 - 移除原有的样式 */
.streaming-indicator {
  display: none;
}

/* 预览文本样式 */
.preview-text {
  margin-top: 10rpx;
  opacity: 0.8;
  background-color: rgba(255, 255, 255, 0.9);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
  border-left: 6rpx solid #4CAF50;
}

/* 中断按钮样式 */
.stop-generation {
  margin-left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #f44336;
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
  font-size: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.stop-icon {
  transform: scale(0.7);
}

/* 移除所有加载状态相关样式 */
.loading-placeholder,
.loading-dots,
.dot {
  display: none;
}

/* 禁用所有动画 */
@keyframes dotPulse {
  0%, 100% { transform: none; opacity: 1; }
  50% { transform: none; opacity: 1; }
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 1; }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
} 