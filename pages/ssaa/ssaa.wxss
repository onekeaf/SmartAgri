/* pages/ssaa/ssaa.wxss */
page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #f6f6f6;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  box-sizing: border-box;
}

.page-container {
  width: 100%;
  height: 100%;
  max-width: 750rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: relative;
}

/* 头部样式 */
.header {
  width: 100%;
  padding: 40rpx 0;
  background: linear-gradient(90deg, #5C6BC0, #7986CB);
  color: white;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

.header-title {
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.8;
}

/* 选项卡样式 */
.tabs {
  display: flex;
  width: 100%;
  background-color: white;
  border-bottom: 2rpx solid #eee;
}

.tab {
  flex: 1;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #5C6BC0;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 6rpx;
  background-color: #5C6BC0;
  border-radius: 3rpx;
}

/* 筛选条件样式 */
.filter-container {
  background-color: white;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.filter-item {
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f6f6f6;
}

.filter-item:last-child {
  border-bottom: none;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.filter-btn {
  padding: 12rpx 30rpx;
  margin-left: 20rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  color: #666;
}

.filter-btn.primary {
  background-color: #5C6BC0;
  color: white;
}

/* 滚动区域样式 */
.scroll-container {
  flex: 1;
  height: calc(100vh - 350rpx); /* 减去头部、选项卡、筛选栏和分页的高度 */
  overflow: hidden;
}

/* 内容容器 */
.content-container {
  padding: 0 20rpx;
}

/* 检查记录列表 */
.inspection-list {
  padding-bottom: 20rpx;
}

.inspection-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.inspection-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.inspection-time {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.next-inspection {
  font-size: 24rpx;
  color: #999;
}

.inspection-summary {
  padding: 20rpx 0;
}

.summary-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 15rpx;
}

.summary-item:last-child {
  margin-bottom: 0;
}

.summary-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
}

.summary-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.inspection-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 15rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-count {
  font-size: 24rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 100rpx;
}

.view-detail {
  font-size: 26rpx;
  color: #5C6BC0;
}

/* 操作日志列表 */
.action-list {
  padding-bottom: 20rpx;
}

.action-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.action-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.action-time {
  font-size: 26rpx;
  color: #999;
}

.action-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.action-status.success {
  background-color: rgba(76, 175, 80, 0.1);
  color: #43a047;
}

.action-status.failed {
  background-color: rgba(244, 67, 54, 0.1);
  color: #e53935;
}

.action-content {
  margin-bottom: 15rpx;
}

.action-type {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.action-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.device-tag {
  position: absolute;
  top: 25rpx;
  right: 25rpx;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background-color: #f0f0f0;
  color: #777;
  border-radius: 4rpx;
}

/* 底部空白区域 */
.bottom-space {
  height: 120rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  color: #ccc;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 分页控制 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
  background-color: white;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 10;
}

.page-btn {
  padding: 10rpx 30rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  margin: 0 20rpx;
  font-size: 26rpx;
  color: #5C6BC0;
}

.page-btn.disabled {
  color: #ccc;
  border-color: #eee;
  pointer-events: none;
}

.page-info {
  font-size: 26rpx;
  color: #666;
}

/* 加载中状态 */
.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.8);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #5C6BC0;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.detail-modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 80%;
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  line-height: 1;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 25rpx;
  max-height: 960rpx;
}

.detail-section {
  margin-bottom: 30rpx;
}

.detail-section:last-child {
  margin-bottom: 0;
}

.detail-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.detail-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.actions-list {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  overflow: hidden;
}

.action-item-detail {
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.action-item-detail:last-child {
  border-bottom: none;
}

.action-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.action-device {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.action-item-content {
  font-size: 24rpx;
  color: #666;
}