/* data-details.wxss */
page {
  background-color: #f6f8fa;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
}

.container {
  width: 100%;
  padding: 0 0 30rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 标题区域 */
.header {
  width: 100%;
  padding: 40rpx 30rpx;
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
  color: white;
  margin-bottom: 15rpx;
  box-shadow: 0 4rpx 6rpx rgba(76, 175, 80, 0.15);
  position: relative;
  overflow: hidden;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  right: 0;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
  border-radius: 50%;
  transform: translate(50%, 50%);
}

.header-title {
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.header-desc {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.update-time {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 数据摘要 */
.data-summary {
  width: 100%;
  display: flex;
  justify-content: space-between;
  background-color: white;
  padding: 25rpx 20rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.summary-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  position: relative;
}

.summary-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 2rpx;
  background-color: #f0f0f0;
}

.summary-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.summary-value {
  font-size: 42rpx;
  font-weight: bold;
  color: #4CAF50;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.05);
}

/* 湿度摘要样式 */
.humidity-summary {
  margin-top: -5rpx;
  margin-bottom: 15rpx;
}

.humidity-summary .summary-value {
  color: #2196F3;
  opacity: 0.9;
}

/* 温度和湿度数值显示 */
.summary-value.temperature {
  color: #2196F3;
}

.summary-value.humidity {
  color: #2196F3;
  opacity: 0.85;
}

/* 图表区域 */
.chart-container {
  width: 100%;
  background-color: white;
  padding: 20rpx 15rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative;
  border-radius: 2rpx;
}

.chart-canvas {
  width: 100%;
  height: 400rpx;
  display: block;
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx dashed #eee;
  display: block; /* 显示标题 */
}

.chart-loading, .no-data {
  position: absolute;
  top: 60rpx;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.9);
  z-index: 10;
}

.loading-icon, .no-data-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.loading-text, .no-data-text {
  font-size: 30rpx;
  color: #999;
}

/* 数据记录列表 */
.data-records {
  width: 100%;
  background-color: white;
  padding: 25rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
  border-radius: 2rpx;
}

.records-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
  border-bottom: 2rpx solid #eee;
  padding-bottom: 15rpx;
  display: flex;
  align-items: center;
}

.records-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 30rpx;
  background-color: #4CAF50;
  margin-right: 15rpx;
  border-radius: 3rpx;
}

.records-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.record-item {
  padding: 24rpx 0;
  border-bottom: 1px solid #f0f0f0;
  transition: background-color 0.3s;
}

.record-item:hover, .record-item:active {
  background-color: #f9f9f9;
}

.record-time {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.record-values {
  display: flex;
  flex-wrap: wrap;
}

.record-value {
  font-size: 32rpx;
  color: #333;
  margin-right: 30rpx;
  font-weight: 500;
}

/* 针对特定数据类型的样式 */
.soil .summary-value {
  color: #4CAF50;
}

.air .summary-value {
  color: #2196F3;
}

.light .summary-value {
  color: #FFC107;
}

/* 数据记录值的颜色 */
.record-value.soil {
  color: #4CAF50;
}

.record-value.light {
  color: #FFC107;
}

.record-value.temperature {
  color: #2196F3;
}

.record-value.humidity {
  color: #2196F3;
}

/* 头部背景颜色根据数据类型变化 */
.soil .header {
  background: linear-gradient(90deg, #388E3C, #4CAF50);
  box-shadow: 0 4rpx 10rpx rgba(76, 175, 80, 0.3);
}

.soil .records-title::before {
  background-color: #4CAF50;
}

.air .header {
  background: linear-gradient(90deg, #1976D2, #2196F3);
  box-shadow: 0 4rpx 10rpx rgba(33, 150, 243, 0.3);
}

.air .records-title::before {
  background-color: #2196F3;
}

.light .header {
  background: linear-gradient(90deg, #FFA000, #FFC107);
  box-shadow: 0 4rpx 10rpx rgba(255, 193, 7, 0.3);
}

.light .records-title::before {
  background-color: #FFC107;
}

.co2-summary {
  background-color: rgba(76, 175, 80, 0.1);
  border-left: 4px solid #4CAF50;
}

.co2 {
  color: #4CAF50;
}

.co2-chart-title {
  color: #4CAF50;
} 