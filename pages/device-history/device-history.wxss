/* device-history.wxss */
.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #4CAF50;
  color: white;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  font-weight: bold;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
}

.nav-placeholder {
  width: 60rpx;
}

/* 历史记录列表 */
.history-list {
  flex: 1;
  padding: 20rpx;
}

.history-item {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
}

.device-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.operation-time {
  font-size: 24rpx;
  color: #999;
}

.history-content {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.status-item {
  display: flex;
  flex-direction: column;
  margin-right: 40rpx;
  margin-bottom: 20rpx;
}

.status-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.status-value {
  font-size: 30rpx;
  color: #333;
  padding: 6rpx 16rpx;
  background-color: #f5f5f5;
  border-radius: 100rpx;
  text-align: center;
}

.status-value.active {
  color: #4CAF50;
  background-color: rgba(76, 175, 80, 0.1);
}

.operation-type .status-value {
  color: #FF9800;
  background-color: rgba(255, 152, 0, 0.1);
}

.operator-info {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  justify-content: space-between;
}

.operator-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 10rpx;
}

.operator-name {
  font-size: 24rpx;
  color: #4CAF50;
  margin-right: auto;
}

.operation-detail {
  margin-left: auto;
}

.operation-detail-text {
  font-size: 24rpx;
  color: #2196F3;
  padding: 6rpx 16rpx;
  background-color: rgba(33, 150, 243, 0.1);
  border-radius: 100rpx;
}

/* 详情区域 */
.detail-section {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  border-left: 4rpx solid #4CAF50;
}

.detail-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.detail-item:last-child {
  margin-bottom: 0;
}

.detail-label {
  font-size: 24rpx;
  color: #666;
  width: 180rpx;
}

.detail-value {
  font-size: 24rpx;
  color: #333;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  color: #ccc;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.loading-icon {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 30rpx 0;
}

/* 三色灯特定样式 */
.status-value.red.active {
  color: #e53935;
  font-weight: bold;
}

.status-value.yellow.active {
  color: #fdd835;
  font-weight: bold;
}

.status-value.green.active {
  color: #43a047;
  font-weight: bold;
} 