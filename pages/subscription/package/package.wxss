page {
  background-color: #f5f5f5;
  padding: 20px;
  box-sizing: border-box;
}

.title {
  text-align: center;
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 30px;
  color: #333;
}

.package-card {
  background: white;
  border-radius: 10px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: 0 2px 5px #eee;
}

.h3 {
  color: #333;
  margin-bottom: 10px;
  font-weight: bold;
  font-size: 18px;
}

.p {
  color: #666;
  margin-bottom: 20px;
  font-size: 14px;
}

.btn {
  background: #52C41A;
  color: white;
  border-radius: 8px;
  font-size: 16px;
  width: 100%;
  border: none;
}
