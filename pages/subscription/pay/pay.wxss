page {
  background-color: #f5f5f5;
  padding: 20px;
  text-align: center;
  box-sizing: border-box;
}

.title {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 20px;
  color: #333;
}

.tip {
  color: #666;
  margin-bottom: 20px;
  font-size: 14px;
}

.code-container {
  margin: 0 auto 30px;
  background: white;
  padding: 10px;
  border: 1px solid #eee;
  width: 220px;
}

.code-img {
  width: 200px;
  height: 200px;
  background: #eee;
}

.placeholder-text {
  font-size: 12px;
  color: #999;
  margin-top: 5px;
}

.btn {
  background: #52C41A;
  color: white;
  border-radius: 8px;
  font-size: 16px;
  width: 100%;
  border: none;
}
