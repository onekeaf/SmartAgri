/* alerts.wxss */
page {
  background-color: #fff;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
}

.container {
  width: 100%;
  padding-bottom: 120rpx;
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
}

/* 标题部分 */
.title-section {
  width: 100%;
  padding: 30rpx 0 40rpx;
  background-color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-box {
  width: 60%;
  padding: 30rpx 20rpx;
  background-color: #4CAF50;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.title-text {
  font-size: 34rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
}

.subtitle-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 下拉菜单样式 */
.filter-dropdown {
  position: relative;
  width: 80%;
  margin: 0 auto 30rpx;
}

.filter-selected {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: white;
  padding: 20rpx 30rpx;
  border-radius: 10rpx;
  border: 1rpx solid #eee;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  font-size: 30rpx;
  color: #333;
}

.dropdown-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #666;
  transition: transform 0.3s;
}

.dropdown-arrow.open {
  transform: rotate(180deg);
}

.dropdown-content {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background-color: white;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  z-index: 20;
  margin-top: 10rpx;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-out;
  opacity: 0;
}

.dropdown-content.show {
  max-height: 600rpx;
  opacity: 1;
}

.dropdown-item {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  border-bottom: 1rpx solid #f5f5f5;
  transition: all 0.2s;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item.active {
  background-color: #f8f8f8;
  color: #4CAF50;
  font-weight: 500;
}

.dropdown-item:active {
  background-color: #f0f0f0;
}

/* 提醒列表样式 */
.alerts-list {
  width: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.alert-item {
  display: flex;
  padding: 30rpx;
  background-color: white;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
  border-left: 5rpx solid #f44336;
  position: relative;
  align-items: center;
  border-radius: 10rpx;
}

.alert-item:active {
  background-color: #f9f9f9;
}

.alert-checkbox {
  margin-right: 15rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  justify-content: center;
  align-items: center;
}

.checkbox.checked {
  border-color: #4CAF50;
  background-color: #4CAF50;
  position: relative;
}

.checkbox.checked::after {
  content: '';
  width: 18rpx;
  height: 10rpx;
  border-left: 3rpx solid white;
  border-bottom: 3rpx solid white;
  transform: rotate(-45deg);
  position: absolute;
  top: 8rpx;
}

.alert-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background-color: rgba(244, 67, 54, 0.1);
  color: #f44336;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 38rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.alert-content {
  flex: 1;
}

.alert-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.alert-message {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.alert-time {
  font-size: 24rpx;
  color: #999;
}

.alert-delete {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-left: 10rpx;
}

.delete-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  color: #999;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  line-height: 1;
}

/* 不同类型的提醒样式 */
.alert-item.soil {
  border-left-color: #4CAF50;
}

.alert-item.soil .alert-icon {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.alert-item.temperature {
  border-left-color: #f44336;
}

.alert-item.temperature .alert-icon {
  background-color: rgba(244, 67, 54, 0.1);
  color: #f44336;
}

.alert-item.humidity {
  border-left-color: #2196F3;
}

.alert-item.humidity .alert-icon {
  background-color: rgba(33, 150, 243, 0.1);
  color: #2196F3;
}

.alert-item.co2 {
  border-left-color: #9c27b0;
}

.alert-item.co2 .alert-icon {
  background-color: rgba(156, 39, 176, 0.1);
  color: #9c27b0;
}

.alert-item.light {
  border-left-color: #FFC107;
}

.alert-item.light .alert-icon {
  background-color: rgba(255, 193, 7, 0.1);
  color: #FFC107;
}

/* 无提醒样式 */
.no-alerts {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.no-alerts-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 60rpx;
  margin-bottom: 30rpx;
}

.no-alerts-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.no-alerts-desc {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  padding: 0 40rpx;
}

/* 底部操作区 */
.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  z-index: 100;
}

.select-all {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.select-all .checkbox {
  margin-right: 10rpx;
}

.delete-selected {
  margin-left: auto;
  background-color: #f5f5f5;
  color: #999;
  padding: 15rpx 30rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  margin-right: 20rpx;
}

.delete-selected.active {
  background-color: #f44336;
  color: white;
}

/* 清空按钮 */
.clear-button {
  background-color: #4CAF50;
  color: white;
  padding: 15rpx 30rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  transition: all 0.3s;
}

.clear-button:active {
  background-color: #388E3C;
  transform: scale(0.98);
}

/* 一键解决按钮样式 */
.solve-btn {
  display: flex;
  align-items: center;
  background-color: #4CAF50;
  color: white;
  padding: 10rpx 20rpx;
  margin-top: 15rpx;
  border-radius: 30rpx;
  width: fit-content;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
}

.solve-btn:active {
  background-color: #388e3c;
  transform: scale(0.98);
}

.solve-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.solve-text {
  font-size: 24rpx;
  font-weight: 500;
} 