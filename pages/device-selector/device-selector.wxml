<!--device-selector.wxml-->
<view class="page-container">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="navigateBack">
      <text class="back-icon">←</text>
    </view>
    <view class="nav-title">选择设备</view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 设备列表 -->
  <view class="device-list">
    <view class="intro-text">请选择要查看历史记录的设备</view>
    <view class="device-item" wx:for="{{deviceList}}" wx:key="id" bindtap="selectDevice" data-device="{{item.id}}">
      <view class="device-icon">{{item.icon}}</view>
      <view class="device-info">
        <view class="device-name">{{item.name}}</view>
        <view class="device-desc">查看设备操作记录</view>
      </view>
      <view class="device-arrow">→</view>
    </view>
  </view>
</view> 