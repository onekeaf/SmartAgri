<view class="page-container">
  <!-- 头部区域 -->
  <view class="header">
    <view class="user-info">
      <view class="avatar-container">
        <image class="avatar" src="{{userInfo.avatar_url}}" mode="aspectFill"></image>
      </view>
      <view class="user-detail">
        <view class="name">{{userInfo.username || '未登录'}}</view>
        <view class="role">{{userInfo.role || '无角色'}}</view>
      </view>
    </view>
  </view>

  <scroll-view class="scrollarea" scroll-y type="list">
    <!-- 用户基本信息卡片 -->
    <view class="card">
      <view class="card-header">
        <view class="card-title">个人信息</view>
        <view class="card-action" bindtap="editUserInfo">编辑</view>
      </view>
      <view class="card-content">
        <view class="info-item">
          <view class="info-icon">📱</view>
          <view class="info-label">手机号</view>
          <view class="info-value">{{userInfo.phone_number || '未设置'}}</view>
        </view>
        <view class="info-item">
          <view class="info-icon">📧</view>
          <view class="info-label">电子邮箱</view>
          <view class="info-value">{{userInfo.email || '未设置'}}</view>
        </view>
      </view>
    </view>

    <!-- 工作信息卡片 -->
    <view class="card">
      <view class="card-header">
        <view class="card-title">工作信息</view>
      </view>
      <view class="card-content">
        <view class="info-item">
          <view class="info-icon">🏢</view>
          <view class="info-label">所属部门</view>
          <view class="info-value">{{userInfo.department || '未设置'}}</view>
        </view>
        <view class="info-item">
          <view class="info-icon">👔</view>
          <view class="info-label">职位</view>
          <view class="info-value">{{userInfo.position || '未设置'}}</view>
        </view>
        <view class="info-item">
          <view class="info-icon">📅</view>
          <view class="info-label">入职日期</view>
          <view class="info-value">{{userInfo.join_date || '未设置'}}</view>
        </view>
        <view class="info-item">
          <view class="info-icon">🔄</view>
          <view class="info-label">工作状态</view>
          <view class="info-value-status">
            <text class="status {{userInfo.work_status === '在岗' ? 'active' : ''}}" data-status="在岗" bindtap="updateWorkStatus">在岗</text>
            <text class="status {{userInfo.work_status === '请假' ? 'active' : ''}}" data-status="请假" bindtap="updateWorkStatus">请假</text>
            <text class="status {{userInfo.work_status === '离岗' ? 'active' : ''}}" data-status="离岗" bindtap="updateWorkStatus">离岗</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 账户与安全卡片 -->
    <view class="card">
      <view class="card-header">
        <view class="card-title">账户与安全</view>
      </view>
      <view class="card-content">
        <view class="info-item" bindtap="changePassword">
          <view class="info-icon">🔒</view>
          <view class="info-label">修改密码</view>
          <view class="info-arrow">></view>
        </view>
        <view class="info-item" bindtap="checkLoginRecords">
          <view class="info-icon">🕒</view>
          <view class="info-label">登录记录</view>
          <view class="info-arrow">></view>
        </view>
      </view>
    </view>

    <!-- 登出按钮 -->
    <view class="logout-button" bindtap="handleLogout">
      退出登录
    </view>
    
    <!-- 版本信息 -->
    <view class="version-info">
      智慧农业系统 v1.0.0
    </view>
  </scroll-view>
</view> 