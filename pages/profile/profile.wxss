/* profile.wxss */
page {
  background-color: #f6f6f6;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
}

.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 头部样式 */
.header {
  padding: 40rpx 30rpx 60rpx;
  background: linear-gradient(135deg, #4CAF50, #2E7D32);
  color: white;
  border-radius: 0 0 30rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  margin: 0;
  width: 100%;
  box-sizing: border-box;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-container {
  padding: 4rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

.user-detail {
  margin-left: 30rpx;
}

.name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.role {
  font-size: 28rpx;
  opacity: 0.9;
}

.scrollarea {
  flex: 1;
  padding: 20rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 8rpx;
  background-color: #4CAF50;
  border-radius: 4rpx;
}

.card-action {
  font-size: 24rpx;
  color: #4CAF50;
}

.card-content {
  padding: 10rpx 0;
}

/* 信息项目样式 */
.info-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.info-item:last-child {
  border-bottom: none;
}

.info-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  color: #666;
}

.info-label {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.info-arrow {
  margin-left: 10rpx;
  color: #ccc;
  font-size: 28rpx;
}

.info-value-status {
  display: flex;
  flex-direction: row;
  margin-left: auto;
}

.status {
  display: inline-block;
  padding: 4rpx 20rpx;
  margin: 0 10rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background-color: #f0f0f0;
  color: #666;
}

.status.active {
  background-color: #07c160;
  color: #fff;
}

/* 状态徽章 */
.status-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 24rpx;
  background-color: #f5f5f5;
  color: #999;
  border-radius: 100rpx;
}

.status-badge.active {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

/* 登出按钮 */
.logout-button {
  margin: 40rpx 0;
  padding: 24rpx 0;
  text-align: center;
  background-color: white;
  color: #f44336;
  font-size: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 版本信息 */
.version-info {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
} 