/* device.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  padding: 0 0 20rpx 0;
  box-sizing: border-box;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  background-color: #4CAF50;
  color: white;
  padding: 40rpx 30rpx;
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
  text-align: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.8;
}

.update-time-container {
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  margin: 0 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.05);
}

.update-time-text {
  font-size: 24rpx;
  color: #666;
}

.big-refresh-button-container {
  display: flex;
  justify-content: center;
  margin: 20rpx 30rpx;
}

.big-refresh-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #4CAF50;
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 30rpx;
  width: 100%;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.big-refresh-button.refreshing {
  opacity: 0.7;
}

.big-refresh-icon {
  margin-right: 15rpx;
  font-size: 36rpx;
}

.big-refresh-text {
  font-size: 28rpx;
  font-weight: bold;
}

.scrollarea {
  flex: 1;
  overflow-y: auto;
  padding: 0 20rpx;
}

.card {
  background-color: white;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.card-action {
  font-size: 26rpx;
  color: #4CAF50;
}

.card-content {
  padding: 10rpx 0;
}

/* 设备管理样式 */
.device-card {
  margin-bottom: 30rpx;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.device-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.device-icon {
  font-size: 42rpx;
  margin-right: 20rpx;
}

.device-name {
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.device-status {
  font-size: 24rpx;
  color: #888;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background-color: #f5f5f5;
}

.device-status.active {
  color: white;
  background-color: #4CAF50;
}

.device-controls {
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.level-selector {
  margin-bottom: 20rpx;
}

.level-text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.auto-mode-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.auto-mode-label {
  font-size: 26rpx;
  color: #666;
}

/* 三色灯样式 */
.traffic-light-container {
  display: flex;
  flex-direction: column;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.traffic-light-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.traffic-light-label {
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
}

.red-light text {
  color: #e53935;
}

.yellow-light text {
  color: #fdd835;
}

.green-light text {
  color: #43a047;
}

.device-history-btn {
  display: flex;
  justify-content: center;
  padding: 15rpx 0;
  margin-top: 10rpx;
  margin-bottom: 20rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
}

.device-history-btn text {
  font-size: 24rpx;
  color: #666;
} 