/**index.wxss**/
page {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #f6f6f6;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  box-sizing: border-box;
}

.page-container {
  width: 100%;
  height: 100%;
  max-width: 750rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 头部样式 */
.header {
  width: 100%;
  padding: 40rpx 0;
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
  color: white;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

.header-title {
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.8;
}

.scrollarea {
  flex: 1;
  width: 100%;
  background-color: #f5f5f5;
  padding: 30rpx 30rpx 100rpx;
  box-sizing: border-box;
}

/* 概览区域 */
.overview-section {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
}

.overview-row {
  display: flex;
  width: 100%;
  justify-content: center;
  margin-bottom: 20rpx;
}

.overview-row:last-child {
  margin-bottom: 0;
}

.overview-item {
  flex: 0 0 45%;
  padding: 20rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin: 0 10rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.overview-item:first-child {
  margin-left: 0;
}

.overview-item:last-child {
  margin-right: 0;
}

.overview-icon {
  font-size: 48rpx;
  margin-right: 12rpx;
}

.overview-data {
  display: flex;
  flex-direction: column;
}

.overview-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.overview-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 土壤湿度 */
.soil .overview-value {
  color: #4CAF50;
}

/* 土壤卡片标题颜色 */
.soil-card .card-title::before {
  background-color: #4CAF50;
}

.soil-card .progress-fill {
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
}

.soil-card .card-action {
  color: #4CAF50;
}

/* 空气湿度 */
.humidity .overview-value {
  color: #2196F3;
}

/* 温度 */
.temperature .overview-value {
  color: #2196F3;
}

/* 空气卡片标题颜色 */
.air-card .card-title::before {
  background-color: #2196F3;
}

.air-card .card-action {
  color: #2196F3;
}

.air-card .metric-value {
  color: #2196F3;
}

/* 光照 */
.light .overview-value {
  color: #FFC107;
}

/* 光照卡片标题颜色 */
.light-card .card-title::before {
  background-color: #FFC107;
}

.light-card .progress-fill {
  background: linear-gradient(90deg, #FFC107, #FFEB3B);
}

.light-card .card-action {
  color: #FFC107;
}

/* 卡片样式 */
.card {
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  width: 100%;
}

.card-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 8rpx;
  border-radius: 4rpx;
}

.card-action {
  font-size: 24rpx;
}

.card-content {
  padding: 30rpx;
}

/* 进度条样式 */
.progress-container {
  padding: 10rpx 0;
}

.progress-bar {
  height: 16rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

/* 默认进度条填充样式，卡片中会被覆盖 */
.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-label {
  font-size: 26rpx;
  color: #666;
  text-align: right;
}

/* 度量网格 */
.metrics-grid {
  display: flex;
  justify-content: space-around;
}

.metric-item {
  text-align: center;
  padding: 20rpx;
  flex: 1;
}

.metric-value {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.metric-label {
  font-size: 26rpx;
  color: #666;
}

/* 设备项目 */
.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.device-item:last-child {
  border-bottom: none;
}

.device-info {
  display: flex;
  align-items: center;
}

.device-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.device-name {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.device-status {
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 16rpx;
  background-color: #f5f5f5;
  border-radius: 100rpx;
}

.device-status.active {
  color: #4CAF50;
  background-color: rgba(76, 175, 80, 0.1);
}

.device-control {
  padding-left: 20rpx;
}

/* 级别选择器 */
.device-controls {
  padding: 10rpx 0 20rpx;
}

.level-selector {
  padding: 10rpx 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  margin-top: 10rpx;
  margin-bottom: 20rpx;
}

.level-text {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

/* 自动模式控制 */
.auto-mode-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.auto-mode-label {
  font-size: 24rpx;
  color: #666;
}

/* 历史记录按钮 */
.history-button {
  text-align: center;
  font-size: 24rpx;
  color: #4CAF50;
  padding: 16rpx;
  background-color: rgba(76, 175, 80, 0.1);
  border-radius: 12rpx;
}

/* 修改开关样式 */
switch {
  transform: scale(0.9);
}

/* 添加数据平滑过渡动画 */
.animated {
  transition: all 0.8s ease-out;
}

.animated-progress {
  transition: width 1s ease-in-out;
}

/* 空气情况卡片中的数据平滑过渡 */
.metrics-grid .metric-value {
  transition: all 0.8s ease-out;
}

/* 温度图标根据温度值变色 */
.temperature .overview-icon {
  transition: color 0.8s ease;
}

/* 最后更新时间显示框样式 */
.update-time-container {
  width: 100%;
  padding: 10rpx 30rpx;
  background-color: rgba(249, 249, 249, 0.95);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  border-bottom: 1rpx solid #eee;
}

.update-time-text {
  flex: 1;
}

.refresh-button {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background-color: #4CAF50;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
}

.refresh-button:active {
  background-color: #388E3C;
  transform: scale(0.95);
}

.refresh-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.refresh-text {
  font-size: 24rpx;
}

/* 刷新动画 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.refreshing .refresh-icon {
  display: inline-block;
  animation: spin 1s linear infinite;
}

/* 三色灯控制样式 */
.traffic-light-controls {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  margin-bottom: 20rpx;
}

.light-control-item {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  margin: 0 10rpx;
}

.light-control-item:first-child {
  margin-left: 0;
}

.light-control-item:last-child {
  margin-right: 0;
}

.light-label {
  font-size: 26rpx;
  font-weight: bold;
}

/* 大的刷新按钮 */
.big-refresh-button-container {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
  background-color: #f5f5f5;
}

.big-refresh-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90%;
  padding: 24rpx 0;
  border-radius: 12rpx;
  background: linear-gradient(to right, #4CAF50, #8BC34A);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 10rpx rgba(76, 175, 80, 0.3);
  transition: all 0.3s ease;
}

.big-refresh-button:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 5rpx rgba(76, 175, 80, 0.3);
}

.big-refresh-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.big-refresh-text {
  font-size: 32rpx;
}

.big-refresh-button.refreshing .big-refresh-icon {
  display: inline-block;
  animation: spin 1s linear infinite;
}

.light-tip {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  background-color: #f5f5f5;
  padding: 12rpx;
  border-radius: 8rpx;
  margin-bottom: 15rpx;
  border-left: 4rpx solid #fdd835;
}

.traffic-light-container {
  padding: 15rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.traffic-light-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.traffic-light-row:last-child {
  border-bottom: none;
}

.traffic-light-label {
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
}

.traffic-light-label.red-light text {
  color: #e53935;
}

.traffic-light-label.yellow-light text {
  color: #fdd835;
}

.traffic-light-label.green-light text {
  color: #43a047;
}

.traffic-light-switch {
  margin-right: 10rpx;
}

.device-card .card-title::before {
}

/* 消息提示模块样式 */
.alert-card {
  margin-bottom: 20rpx;
}

.alerts-container {
  width: 100%;
}

.alert-item {
  display: flex;
  padding: 20rpx 15rpx;
  background-color: #f9f9f9;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.alert-item:active {
  background-color: #f0f0f0;
}

.alert-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(244, 67, 54, 0.1);
  color: #f44336;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.alert-content {
  flex: 1;
}

.alert-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.alert-message {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.alert-time {
  font-size: 22rpx;
  color: #999;
}

.alerts-count {
  text-align: center;
  font-size: 24rpx;
  color: #666;
  padding: 10rpx 0;
}

.no-alerts {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.no-alerts-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  margin-bottom: 15rpx;
}

.no-alerts-text {
  font-size: 28rpx;
  color: #666;
}

/* 不同类型的提醒样式 */
.alert-item.soil .alert-icon {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.alert-item.temperature .alert-icon {
  background-color: rgba(244, 67, 54, 0.1);
  color: #f44336;
}

.alert-item.humidity .alert-icon {
  background-color: rgba(33, 150, 243, 0.1);
  color: #2196F3;
}

.alert-item.co2 .alert-icon {
  background-color: rgba(156, 39, 176, 0.1);
  color: #9c27b0;
}

.alert-item.light .alert-icon {
  background-color: rgba(255, 193, 7, 0.1);
  color: #FFC107;
}

/* 智能提醒一键解决按钮 */
.quick-solve-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #4CAF50;
  color: white;
  padding: 16rpx 30rpx;
  margin: 20rpx 0;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.quick-solve-btn:active {
  background-color: #388e3c;
  transform: scale(0.98);
}

.solve-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.solve-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 添加详情按钮样式 */
.overview-detail {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  font-size: 22rpx;
  color: #333;
  background-color: rgba(0, 0, 0, 0.05);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.soil .overview-detail {
  color: #4CAF50;
}

.humidity .overview-detail, 
.temperature .overview-detail {
  color: #2196F3;
}

.light .overview-detail {
  color: #FFC107;
}

/* 添加点击效果 */
.overview-detail:active {
  opacity: 0.7;
}

/* SSAA卡片样式 */
.ssaa-card .card-title::before {
  background-color: #5C6BC0;
}

.ssaa-card .card-action {
  color: #5C6BC0;
}

.ssaa-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.ssaa-info {
  display: flex;
  align-items: center;
}

.ssaa-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
  color: #5C6BC0;
}

.ssaa-description {
  display: flex;
  flex-direction: column;
}

.ssaa-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.ssaa-status {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

.ssaa-control {
  display: flex;
  align-items: center;
}

.ssaa-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.ssaa-tips {
  display: flex;
  align-items: center;
  background-color: rgba(92, 107, 192, 0.1);
  padding: 16rpx;
  margin-top: 20rpx;
  border-radius: 8rpx;
}

.ssaa-tips-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.ssaa-tips-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.ssaa-last-update {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
}
