<view class="login-container">
  <view class="login-header">
    <view class="logo-container">
      <view class="logo-circle">
        <view class="logo-icon">🌱</view>
      </view>
    </view>
    <view class="login-title">智慧农业系统</view>
    <view class="login-subtitle">智能监控，高效种植</view>
  </view>
  
  <view class="login-form">
    <view class="input-group">
      <view class="input-icon">👤</view>
      <input 
        type="text" 
        placeholder="请输入手机号" 
        placeholder-class="placeholder"
        bindinput="onPhoneInput" />
    </view>
    
    <view class="input-group">
      <view class="input-icon">🔒</view>
      <input 
        type="password" 
        placeholder="请输入密码" 
        placeholder-class="placeholder"
        bindinput="onPasswordInput" />
    </view>
    
    <view class="remember-forgot">
      <view class="remember-me">
        <checkbox checked="{{rememberPassword}}" bindchange="toggleRememberPassword" color="#4CAF50" />
        <text>记住密码</text>
      </view>
      <view class="forgot-password" bindtap="forgotPassword">忘记密码?</view>
    </view>
    
    <button class="login-btn" bindtap="handleLogin" loading="{{isLoading}}" disabled="{{isLoading}}">登录</button>
    
    <view class="register-link" bindtap="goToRegister">
      还没有账号？<text class="highlight">立即注册</text>
    </view>
  </view>
  
  <view class="login-footer">
    <view class="footer-text">智慧农业 · 科技改变生活</view>
    <view class="decoration-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>
  
  <!-- 装饰元素 -->
  <view class="decoration-circle circle-1"></view>
  <view class="decoration-circle circle-2"></view>
  <view class="decoration-circle circle-3"></view>
</view> 