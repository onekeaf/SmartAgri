
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 图片上传区域 */
.image-section {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.image-scroll {
  white-space: nowrap;
}

.image-list {
  display: inline-flex;
  align-items: center;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.image-preview {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fff;
}

.delete-icon {
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
}

.add-image-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #d9d9d9;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-icon {
  color: #999;
  font-size: 80rpx;
  line-height: 1;
}

.image-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 表单区域 */
.form-scroll {
  background-color: #fff;
  padding: 0 30rpx;
  max-height: calc(100vh - 400rpx);
}

.form-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.required {
  color: #ff4d4f;
  margin-right: 4rpx;
}

.form-input {
  font-size: 28rpx;
  color: #333;
  width: 100%;
  line-height: 1.5;
}

.input-with-unit {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.unit {
  font-size: 28rpx;
  color: #999;
  margin-left: 20rpx;
}

/* Picker样式 */
.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.picker-text.placeholder {
  color: #ccc;
}

.picker-arrow {
  font-size: 40rpx;
  color: #999;
  transform: rotate(90deg);
  margin-left: 20rpx;
}

/* Textarea样式 */
.textarea-wrapper {
  position: relative;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  padding: 20rpx;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.textarea-counter {
  position: absolute;
  bottom: 10rpx;
  right: 20rpx;
  font-size: 24rpx;
  color: #999;
}

/* 底部按钮 */
.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background-color: #4CAF50;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.save-btn::after {
  border: none;
}
