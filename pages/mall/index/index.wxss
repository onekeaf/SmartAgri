
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 180rpx;
}

/* 统计栏样式 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: #fff;
  padding: 32rpx 24rpx;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: center;
}

.stat-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f0f0f0;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.stat-icon-wrapper.on-sale-bg {
  background-color: #e8f5e9;
}

.stat-icon-wrapper.off-sale-bg {
  background-color: #f5f5f5;
}

.stat-icon {
  font-size: 32rpx;
}

.stat-text {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.2;
}

.stat-value.on-sale {
  color: #4CAF50;
}

.stat-value.off-sale {
  color: #999;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #eee;
  flex-shrink: 0;
}

/* 商品网格布局 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  gap: 20rpx;
}

/* 商品卡片样式 */
.product-card {
  width: calc(50% - 10rpx);
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

.product-image-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
}

.product-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 状态标签样式 */
.status-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #fff;
  z-index: 1;
}

.status-on-sale {
  background-color: #4CAF50;
}

.status-off-sale {
  background-color: #999;
}

/* 商品信息 */
.product-info {
  padding: 20rpx;
}

.product-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #4CAF50;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

/* 加载更多提示 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 24rpx;
}

/* 悬浮按钮样式 */
.float-button {
  position: fixed;
  right: 30rpx;
  bottom: 180rpx;
  width: 112rpx;
  height: 112rpx;
  background-color: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.4);
  z-index: 999;
}

.float-button-icon {
  font-size: 60rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}
