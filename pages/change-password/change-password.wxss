.container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.form {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  text-align: center;
  color: #333;
}

.input-group {
  margin-bottom: 30rpx;
}

input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #f8f8f8;
}

.tips {
  margin: 30rpx 0;
  display: flex;
  flex-direction: column;
}

.tips text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.btn-submit, .btn-cancel {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.btn-submit {
  background-color: #07c160;
  color: #fff;
}

.btn-cancel {
  background-color: #f2f2f2;
  color: #666;
} 